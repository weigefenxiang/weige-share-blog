# Base config for official OpenWrt, device: Qihoo 360T7 (mediatek/filogic)
# 最小种子配置:只写目标机型与 LuCI 基础,其余由 CI 的 make defconfig 展开。
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_qihoo_360t7=y
CONFIG_TARGET_BOARD="mediatek"
CONFIG_TARGET_SUBTARGET="filogic"
CONFIG_TARGET_PROFILE="DEVICE_qihoo_360t7"
CONFIG_TARGET_ARCH_PACKAGES="aarch64_cortex-a53"
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_default-settings-chn=n
CONFIG_PACKAGE_kmod-mt7981-firmware=y
CONFIG_PACKAGE_wpad-openssl=y
# CONFIG_PACKAGE_luci-app-acl is not set
# CONFIG_PACKAGE_luci-app-acme is not set
# CONFIG_PACKAGE_luci-app-adblock-fast is not set
