# Optional template only: no live R2 credentials.
name = "weig-gitalk-attachments"
main = "worker.mjs"
compatibility_date = "2026-10-21"
[vars]
ALLOWED_ORIGINS = "https://dev.weige-share-blog.pages.dev,https://weigshare.com,https://www.weigshare.com"
PUBLIC_ASSET_BASE = "https://your-dedicated-attachments-domain.example"
[[r2_buckets]]
binding = "COMMENTS_BUCKET"
bucket_name = "create-a-dedicated-upload-bucket"
[[unsafe.bindings]]
name = "UPLOAD_RATE_LIMITER"
type = "ratelimit"
namespace_id = "1001"
simple = { limit = 10, period = 60 }
# ZIP disabled until external malware scanning is deployed.
